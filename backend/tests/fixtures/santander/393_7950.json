    "additionalText": "<p><span style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\">Beneficio exclusivo para clientes suscriptos a </span><strong style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\">Sorpresa Santander</strong><span style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\"> y </span><strong style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\">PedidosYa Plus</strong><span style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\">.</span></p><p></p><p><span style=\"background-color: rgb(255, 255, 255); color: rgb(79, 84, 87); font-size: 14px;\">Promoción válida únicamente en restaurantes.</span></p>",
    "monthlyCut": true,
